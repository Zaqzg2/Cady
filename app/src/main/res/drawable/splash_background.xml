<?xml version="1.0" encoding="utf-8"?>
<!-- Shown as the window background from the moment the process starts until
     Compose draws its first frame (see themes.xml): the page colour with the
     Cady logo in the middle, so cold start reads as "كادي is opening" instead of
     a blank rectangle. The logo is the same artwork as the launcher icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_page" />
    <item
        android:width="220dp"
        android:height="124dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
